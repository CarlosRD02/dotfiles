{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
      "1": "white",
      "2": "red"
    }
  },
  "display": {
    "color": {
      "title": "red"
    },
    "hideCursor": false,
  //  "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{2} {8} {10} {12}",
      "keyColor": "red",
      "key": " "

    },
    {
      "type": "host",
      "keyColor": "red",
      "key": " "
 
    },
    {
      "type": "kernel",
      "keyColor": "green",
      "key": " "
 
    },
    {
      "type": "uptime",
      "keyColor": "green",
      "key": " "
    },
    {
      "type": "Packages",
      "keyColor": "yellow",
      "key": "󰏔 "
    },
    {
      "type": "shell",
      "keyColor": "yellow",
      "key": " "
    },
     {
      "type": "display",
      "keyColor": "blue",
      "key": " "
    },
     {
      "type": "DE",
      "keyColor": "blue",
      "key": " "
    },
     {
      "type": "WM",
      "keyColor": "red",
      "key": " "
    },

    {
      "type": "Theme",
      "format": "{2}",
      "keyColor": "red",
      "key": "󰉼 "
    },
    {
      "type": "Icons",
      "format": "{2}",
      "keyColor": "cyan",
      "key": "󰀻 "
    },

    {
      "type": "Font",
      "format": "{1}",
      "keyColor": "cyan",
      "key": " "
    },
    {
      "type": "terminal",
      "keyColor": "green",
      "key": " "
    },
    {
      "type": "CPU",
      "keyColor": "green",
      "key": " "
    },
    {
      "type": "gpu",
      "format": "{2}",
      "keyColor": "blue",
      "detectionMethod": "vulkan",
     // "showCores"
      "key": "󰢮 "
    },

     {
      "type": "memory",
      "keyColor": "blue",
      "key": " "
    },
    {
      "type": "command",
      "key": "󰔟 ",
      "keyColor": "green",
      "text": "echo $(($(($(date +%s) - $(stat -c %W /))) / 86400)) días"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 0,
      "symbol": "circle"
    },
    

  ]
}
